# Docker environment variables for Note in the box
# Copy this file to .env.docker and adjust values for your deployment
# NEVER commit .env.docker to version control!

# Application
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Database (production)
# Format: postgresql://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://nib_user:CHANGE_ME@db:5432/nib_prod?sslmode=disable

# Database (test - used by test profile)
DATABASE_URL_TEST=postgresql://nib_user:CHANGE_ME@db:5432/nib_test?sslmode=disable

# Application origin (must be HTTPS in production)
# Example: https://minha-instancia.exemplo.com
APP_ORIGIN=http://localhost

# Legal documents versions (update when terms/privacy change)
TERMS_VERSION=terms-v1
PRIVACY_VERSION=privacy-v1

# Set to "true" only after human review of termos.html and privacidade.html
LEGAL_DOCUMENTS_APPROVED=false

# PostgreSQL (db service)
POSTGRES_USER=nib_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nib_prod