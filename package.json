{
  "name": "note-in-the-box",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server/index.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "migrate:test": "node --env-file=.env scripts/migrate.js --test",
    "retention:cleanup": "node --env-file=.env scripts/cleanup-retention.js",
    "test": "node --test tests/**/*.test.js",
    "test:security": "node --test tests/security/**/*.test.js",
    "verify": "npm run test && npm run test:security && npm audit --omit=dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "docker compose run --rm app node scripts/migrate.js",
    "docker:test": "docker compose --profile test up --build --abort-on-container-exit test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
